#!/usr/bin/env bash
# Configures Nginx with a custom 404 page containing "Ceci n'est pas une page"

apt-get update
apt-get -y install nginx

echo "Holberton School for the win!" > /var/www/html/index.html

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/5-design_a_beautiful_404_page.html" ]; then
	cp "$SCRIPT_DIR/5-design_a_beautiful_404_page.html" /var/www/html/404.html
else
	echo "Ceci n'est pas une page" > /var/www/html/404.html
fi

sed -i '/listen \[::\]:80 default_server;/a\
\
	location /redirect_me {\
		return 301 "https://www.youtube.com/watch?v=QH2-TGUlwu4";\
	}' /etc/nginx/sites-enabled/default

sed -i 's/#\s*error_page 404 \/404.html;/error_page 404 =404 \/404.html;/' /etc/nginx/sites-enabled/default
sed -i 's/error_page 404 \/404.html;/error_page 404 =404 \/404.html;/' /etc/nginx/sites-enabled/default

service nginx restart
